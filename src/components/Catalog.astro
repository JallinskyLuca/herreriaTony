---
import { siteConfig, buildWhatsAppUrl } from '../config/site';

const herreriaServices = siteConfig.services.filter(s => s.category === 'herreria');
const obraSeguridadServices = siteConfig.services.filter(s => s.category === 'obra-seguridad');
const albanileriaServices = siteConfig.services.filter(s => s.category === 'albanileria');
---

<section id="trabajos" class="relative py-20 lg:py-28 bg-iron-950 border-b border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 border-b border-zinc-800 pb-8">
      <div>
        <div class="inline-flex items-center gap-2 font-mono text-xs text-forge-400 uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-forge-500"></span>
          <span>FOTOS REALES DE TALLER Y OBRAS</span>
        </div>
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-zinc-100 uppercase">
          NUESTROS TRABAJOS DE <span class="text-forge-500">HERRERÍA & ALBAÑILERÍA</span>
        </h2>
      </div>
      <div class="max-w-md font-mono text-xs text-zinc-400">
        <p>
          Mirá cómo trabajamos en el taller y en cada obra: hierro macizo con soldadura de primera calidad, portones pesados, rejas artísticas y construcción integral.
        </p>
      </div>
    </div>

    <!-- ================= CATEGORY 1: HERRERÍA ARTESANAL & TALLER ================= -->
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-8">
        <div class="px-3 py-1 bg-forge-500/10 border border-forge-500/30 rounded font-mono text-xs text-forge-400 font-bold uppercase tracking-wider">
          HERRERÍA_01
        </div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold text-zinc-100 tracking-wide uppercase">
          Herrería Artesanal, Forja & Taller Metalúrgico
        </h3>
        <div class="hidden sm:block flex-1 h-px bg-zinc-800"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {herreriaServices.map((service) => (
          <div class="group flex flex-col justify-between rounded-2xl border border-zinc-800 bg-iron-850 overflow-hidden hover:border-forge-500/60 transition-all duration-300 hover:shadow-[0_12px_40px_rgba(234,88,12,0.18)]">
            <div>
              <!-- Real Work Image with Badge -->
              <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900 border-b border-zinc-800">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 bg-zinc-950/85 border border-zinc-700/80 px-2.5 py-1 rounded font-mono text-[11px] text-forge-400 font-bold tracking-wider uppercase backdrop-blur-sm">
                  {service.badge}
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-6">
                <h4 class="font-display text-2xl sm:text-3xl text-zinc-100 font-bold uppercase tracking-wide group-hover:text-forge-400 transition-colors">
                  {service.title}
                </h4>
                <p class="font-mono text-xs text-forge-400 font-medium mb-3">
                  {service.subtitle}
                </p>
                <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">
                  {service.description}
                </p>

                <!-- Specs List -->
                <div class="border-t border-zinc-800/80 pt-3">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase mb-2">Características Destacadas:</div>
                  <ul class="space-y-1.5 font-mono text-xs text-zinc-300">
                    {service.specs.map((spec) => (
                      <li class="flex items-start gap-2">
                        <span class="text-forge-500 font-bold shrink-0">▸</span>
                        <span>{spec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Card Bottom: WhatsApp Direct Quote CTA -->
            <div class="p-6 pt-0">
              <a
                href={buildWhatsAppUrl(service.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-between w-full px-5 py-3 rounded-xl bg-zinc-900 group-hover:bg-forge-500 text-zinc-300 group-hover:text-zinc-950 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-zinc-700/80 group-hover:border-forge-400 shadow-sm"
              >
                <span>Cotizar este trabajo por WhatsApp</span>
                <span class="font-mono text-base transform group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ================= CATEGORY 2: HERRERÍA DE OBRA & SEGURIDAD ================= -->
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-8">
        <div class="px-3 py-1 bg-amber-500/10 border border-amber-500/30 rounded font-mono text-xs text-amber-400 font-bold uppercase tracking-wider">
          SEGURIDAD_02
        </div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold text-zinc-100 tracking-wide uppercase">
          Herrería de Obra, Portones, Rejas & Estructuras
        </h3>
        <div class="hidden sm:block flex-1 h-px bg-zinc-800"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {obraSeguridadServices.map((service) => (
          <div class="group flex flex-col justify-between rounded-2xl border border-zinc-800 bg-iron-850 overflow-hidden hover:border-amber-500/60 transition-all duration-300 hover:shadow-[0_12px_40px_rgba(245,158,11,0.15)]">
            <div>
              <!-- Real Work Image -->
              <div class="relative aspect-[16/11] overflow-hidden bg-zinc-900 border-b border-zinc-800">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 bg-zinc-950/85 border border-zinc-700/80 px-2.5 py-1 rounded font-mono text-[11px] text-amber-400 font-bold tracking-wider uppercase backdrop-blur-sm">
                  {service.badge}
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-5">
                <h4 class="font-display text-2xl text-zinc-100 font-bold uppercase tracking-wide group-hover:text-amber-400 transition-colors">
                  {service.title}
                </h4>
                <p class="font-mono text-xs text-amber-400 font-medium mb-3">
                  {service.subtitle}
                </p>
                <p class="text-xs text-zinc-300 leading-relaxed mb-4">
                  {service.description}
                </p>

                <!-- Specs List -->
                <div class="border-t border-zinc-800/80 pt-3">
                  <ul class="space-y-1.5 font-mono text-[11px] text-zinc-300">
                    {service.specs.map((spec) => (
                      <li class="flex items-start gap-2">
                        <span class="text-amber-400 font-bold shrink-0">▸</span>
                        <span>{spec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Card Bottom: WhatsApp Direct Quote CTA -->
            <div class="p-5 pt-0">
              <a
                href={buildWhatsAppUrl(service.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-zinc-900 group-hover:bg-amber-500 text-zinc-300 group-hover:text-zinc-950 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-zinc-700/80 group-hover:border-amber-400 shadow-sm"
              >
                <span>Cotizar este trabajo</span>
                <span class="font-mono text-sm transform group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ================= CATEGORY 3: ALBAÑILERÍA & CONSTRUCCIÓN INTEGRAL ================= -->
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-8">
        <div class="px-3 py-1 bg-emerald-500/10 border border-emerald-500/30 rounded font-mono text-xs text-emerald-400 font-bold uppercase tracking-wider">
          CONSTRUCCIÓN_03
        </div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold text-zinc-100 tracking-wide uppercase">
          Albañilería de Obra, Mampostería, Losas & Reformas
        </h3>
        <div class="hidden sm:block flex-1 h-px bg-zinc-800"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {albanileriaServices.map((service) => (
          <div class="group flex flex-col justify-between rounded-2xl border border-zinc-800 bg-iron-850 overflow-hidden hover:border-emerald-500/60 transition-all duration-300 hover:shadow-[0_12px_40px_rgba(16,185,129,0.15)]">
            <div>
              <!-- Real Work Image -->
              <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900 border-b border-zinc-800">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 bg-zinc-950/85 border border-zinc-700/80 px-2.5 py-1 rounded font-mono text-[11px] text-emerald-400 font-bold tracking-wider uppercase backdrop-blur-sm">
                  {service.badge}
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-6">
                <h4 class="font-display text-2xl sm:text-3xl text-zinc-100 font-bold uppercase tracking-wide group-hover:text-emerald-400 transition-colors">
                  {service.title}
                </h4>
                <p class="font-mono text-xs text-emerald-400 font-medium mb-3">
                  {service.subtitle}
                </p>
                <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">
                  {service.description}
                </p>

                <!-- Specs List -->
                <div class="border-t border-zinc-800/80 pt-3">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase mb-2">Detalles Constructivos:</div>
                  <ul class="space-y-1.5 font-mono text-xs text-zinc-300">
                    {service.specs.map((spec) => (
                      <li class="flex items-start gap-2">
                        <span class="text-emerald-400 font-bold shrink-0">▸</span>
                        <span>{spec}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <!-- Card Bottom: WhatsApp Direct Quote CTA -->
            <div class="p-6 pt-0">
              <a
                href={buildWhatsAppUrl(service.whatsappMessage)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-between w-full px-5 py-3 rounded-xl bg-zinc-900 group-hover:bg-emerald-500 text-zinc-300 group-hover:text-zinc-950 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-zinc-700/80 group-hover:border-emerald-400 shadow-sm"
              >
                <span>Cotizar obra de albañilería</span>
                <span class="font-mono text-base transform group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          </div>
        ))}

        <!-- Albañilería Complementary Card / Obra en Equipo -->
        <div class="group flex flex-col justify-between rounded-2xl border border-zinc-800 bg-iron-850 overflow-hidden hover:border-emerald-500/60 transition-all duration-300 hover:shadow-[0_12px_40px_rgba(16,185,129,0.15)]">
          <div>
            <div class="relative aspect-[16/10] overflow-hidden bg-zinc-900 border-b border-zinc-800">
              <img
                src="/images/pexels-construccion-total-2464540-10951145.jpg"
                alt="Losa y encadenado de albañilería en obra"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3 bg-zinc-950/85 border border-zinc-700/80 px-2.5 py-1 rounded font-mono text-[11px] text-emerald-400 font-bold tracking-wider uppercase backdrop-blur-sm">
                LOSAS & ENCADENADOS
              </div>
            </div>

            <div class="p-6">
              <h4 class="font-display text-2xl sm:text-3xl text-zinc-100 font-bold uppercase tracking-wide group-hover:text-emerald-400 transition-colors">
                Herrería + Albañilería en un Solo Equipo
              </h4>
              <p class="font-mono text-xs text-emerald-400 font-medium mb-3">
                Solución integral: Amurado directo sin intermediarios
              </p>
              <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">
                El mayor dolor de cabeza al colocar portones, rejas o escaleras es coordinar con un albañil separado. En Herrería Tony nos encargamos de todo: amurado con mortero expansivo, picado de mochetas, bases de hormigón y pintura.
              </p>
              <div class="border-t border-zinc-800/80 pt-3">
                <ul class="space-y-1.5 font-mono text-xs text-zinc-300">
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-400 font-bold shrink-0">▸</span>
                    <span>Amurado estructural de portones y rejas en el día</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-400 font-bold shrink-0">▸</span>
                    <span>Cimientos para frentes y columnas de acceso</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="p-6 pt-0">
            <a
              href={buildWhatsAppUrl("Hola Tony! Me interesa un trabajo combinado de Herrería y Albañilería (amurado, bases, obra):")}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-between w-full px-5 py-3 rounded-xl bg-zinc-900 group-hover:bg-emerald-500 text-zinc-300 group-hover:text-zinc-950 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 border border-zinc-700/80 group-hover:border-emerald-400 shadow-sm"
            >
              <span>Consultar por obra integral</span>
              <span class="font-mono text-base transform group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= FULL WORK GALLERY ================= -->
    <div class="mt-24 pt-16 border-t border-zinc-800">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 font-mono text-xs text-forge-400 uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-forge-500"></span>
          <span>GALERÍA DE PROYECTOS TERMINADOS</span>
        </div>
        <h3 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-zinc-100 uppercase">
          EVIDENCIA DE <span class="text-forge-500">OFICIO EN ACCIÓN</span>
        </h3>
        <p class="font-mono text-xs text-zinc-400 mt-2">
          Cada soldadura, cada muro y cada colocación realizada con materiales de espesor real y mano de obra experta.
        </p>
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {siteConfig.gallery.map((item) => (
          <div class="group relative rounded-xl border border-zinc-800 bg-iron-850 overflow-hidden hover:border-forge-500/50 transition-all duration-300">
            <div class="relative aspect-[4/3] overflow-hidden bg-zinc-900">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/90 via-zinc-950/20 to-transparent"></div>
              <div class="absolute top-2.5 left-2.5 bg-zinc-950/85 border border-zinc-700/80 px-2 py-0.5 rounded font-mono text-[10px] text-forge-400 font-bold uppercase backdrop-blur-sm">
                {item.tag}
              </div>
            </div>

            <div class="p-4">
              <div class="font-mono text-[10px] text-zinc-500 uppercase mb-1">{item.categoryName}</div>
              <h4 class="font-display text-lg text-zinc-100 font-bold uppercase tracking-wide group-hover:text-forge-400 transition-colors line-clamp-1">
                {item.title}
              </h4>
              <p class="text-xs text-zinc-400 mt-1 line-clamp-2 leading-relaxed">
                {item.description}
              </p>
              <div class="mt-3 pt-3 border-t border-zinc-800/80 flex items-center justify-between">
                <a
                  href={buildWhatsAppUrl(`Hola Tony! Vi esta foto en la galería ("${item.title}") y me interesa cotizar algo similar:`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[11px] text-forge-400 hover:text-forge-300 font-bold uppercase flex items-center gap-1"
                >
                  <span>Pedir algo así</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
