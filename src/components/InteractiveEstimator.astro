---
import {
  BrickWall,
  Check,
  DoorOpen,
  Flame,
  Layers3,
  MapPin,
  MessageCircle,
  Ruler,
  Warehouse,
} from 'lucide-astro';
import { siteConfig } from '../config/site';

const serviceOptions = [
  { Icon: DoorOpen, label: 'Portones', value: 'Portón corredizo o levadizo' },
  { Icon: Layers3, label: 'Rejas', value: 'Rejas para frente, ventanas o balcón' },
  { Icon: Flame, label: 'Forja y muebles', value: 'Forja, parrilla o mueble de hierro y madera' },
  { Icon: Warehouse, label: 'Estructuras', value: 'Escalera, techo, tinglado o estructura metálica' },
  { Icon: BrickWall, label: 'Albañilería', value: 'Albañilería, muro, losa o revoque' },
  { Icon: Check, label: 'Trabajo combinado', value: 'Herrería y albañilería en un mismo proyecto' },
];
---

<section id="cotizador" aria-labelledby="cotizador-titulo" class="scroll-mt-24 border-b border-zinc-800 bg-iron-900 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-forge-400">
        <span class="size-2 rounded-full bg-forge-500"></span>
        Consulta directa por WhatsApp
      </p>
      <h2 id="cotizador-titulo" class="font-display text-4xl font-bold uppercase leading-none tracking-tight text-zinc-100 sm:text-5xl lg:text-6xl">
        Contanos qué <span class="text-forge-500">necesitás</span>
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-400">
        Completá los datos que tengas. El formulario prepara un mensaje ordenado para que podamos entender el trabajo y responderte con mayor precisión.
      </p>
    </div>

    <div class="grid overflow-hidden rounded-2xl border border-zinc-700 bg-iron-950 shadow-2xl lg:grid-cols-[18rem_minmax(0,1fr)]">
      <aside class="border-b border-zinc-800 bg-zinc-950/70 p-6 lg:border-b-0 lg:border-r lg:p-8">
        <img src="/images/logo.webp" width="512" height="512" alt="" class="mb-7 size-14 rounded-full object-cover" loading="lazy" />
        <h3 class="font-display text-2xl font-bold uppercase tracking-wide text-zinc-100">Cómo funciona</h3>

        <ol class="mt-6 space-y-6">
          <li class="flex gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-forge-500/50 bg-forge-500/10 text-xs font-bold text-forge-400">1</span>
            <div>
              <p class="font-semibold text-zinc-200">Elegí el trabajo</p>
              <p class="mt-1 text-sm leading-snug text-zinc-500">Indicá el rubro que más se acerca a tu consulta.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-forge-500/50 bg-forge-500/10 text-xs font-bold text-forge-400">2</span>
            <div>
              <p class="font-semibold text-zinc-200">Agregá referencias</p>
              <p class="mt-1 text-sm leading-snug text-zinc-500">Podés completar medidas, localidad y una breve descripción.</p>
            </div>
          </li>
          <li class="flex gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-forge-500/50 bg-forge-500/10 text-xs font-bold text-forge-400">3</span>
            <div>
              <p class="font-semibold text-zinc-200">Enviá por WhatsApp</p>
              <p class="mt-1 text-sm leading-snug text-zinc-500">Se abrirá el mensaje para que lo revises antes de enviarlo.</p>
            </div>
          </li>
        </ol>

        <div class="mt-8 border-t border-zinc-800 pt-6">
          <p class="text-xs text-zinc-500">Atención por WhatsApp</p>
          <p class="mt-1 font-semibold text-zinc-200">{siteConfig.whatsappDisplay}</p>
          <p class="mt-2 text-xs leading-relaxed text-zinc-500">{siteConfig.workshopHours}</p>
        </div>
      </aside>

      <form id="quoteForm" data-whatsapp-number={siteConfig.whatsappNumber} class="p-5 sm:p-8 lg:p-10">
        <fieldset>
          <legend class="text-base font-semibold text-zinc-100">¿Qué tipo de trabajo necesitás?</legend>
          <p class="mt-1 text-sm text-zinc-500">Elegí una opción para comenzar.</p>

          <div class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3">
            {serviceOptions.map(({ Icon, label, value }, index) => (
              <label class="cursor-pointer">
                <input type="radio" name="projectType" value={value} class="peer sr-only" checked={index === 0} />
                <span class="flex min-h-[6.5rem] flex-col justify-between rounded-xl border border-zinc-800 bg-iron-850 p-4 text-zinc-400 transition-colors hover:border-zinc-600 peer-checked:border-forge-500 peer-checked:bg-forge-500/10 peer-checked:text-forge-400 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-forge-400">
                  <Icon aria-hidden="true" class="size-6" stroke-width={1.75} />
                  <span class="mt-3 text-sm font-semibold leading-tight">{label}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="dimensions" class="flex items-center gap-2 text-sm font-semibold text-zinc-200">
              <Ruler aria-hidden="true" class="size-4 text-forge-500" />
              Medidas aproximadas
              <span class="ml-auto text-xs font-normal text-zinc-600">Opcional</span>
            </label>
            <input
              type="text"
              id="dimensions"
              autocomplete="off"
              placeholder="Ej. 3 m de ancho por 2 m de alto"
              class="mt-2 w-full rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-forge-500 focus:ring-2 focus:ring-forge-500/20"
            />
          </div>

          <div>
            <label for="locationInput" class="flex items-center gap-2 text-sm font-semibold text-zinc-200">
              <MapPin aria-hidden="true" class="size-4 text-forge-500" />
              Localidad
              <span class="ml-auto text-xs font-normal text-zinc-600">Opcional</span>
            </label>
            <input
              type="text"
              id="locationInput"
              autocomplete="address-level2"
              placeholder="Ej. San Isidro, CABA"
              class="mt-2 w-full rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3.5 text-sm text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-forge-500 focus:ring-2 focus:ring-forge-500/20"
            />
          </div>
        </div>

        <div class="mt-5">
          <label for="details" class="flex items-center justify-between gap-3 text-sm font-semibold text-zinc-200">
            Describí brevemente el trabajo
            <span class="text-xs font-normal text-zinc-600">Opcional</span>
          </label>
          <textarea
            id="details"
            rows="4"
            placeholder="Contanos qué querés fabricar, reparar o construir. También podés adjuntar fotos cuando se abra WhatsApp."
            class="mt-2 w-full resize-y rounded-xl border border-zinc-700 bg-zinc-900 px-4 py-3.5 text-sm leading-relaxed text-zinc-100 outline-none transition placeholder:text-zinc-600 focus:border-forge-500 focus:ring-2 focus:ring-forge-500/20"
          ></textarea>
        </div>

        <div class="mt-7 border-t border-zinc-800 pt-6">
          <button
            type="submit"
            class="inline-flex min-h-14 w-full items-center justify-center gap-3 rounded-xl bg-forge-500 px-6 py-3.5 text-sm font-bold text-zinc-950 transition-colors hover:bg-forge-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forge-400 sm:w-auto"
          >
            <MessageCircle aria-hidden="true" class="size-5" stroke-width={2.25} />
            Preparar consulta por WhatsApp
          </button>
          <p class="mt-4 max-w-2xl text-xs leading-relaxed text-zinc-500">
            Este sitio no guarda los datos del formulario. Al continuar, la información se incorpora a un mensaje que podrás revisar en WhatsApp antes de enviarlo.
            <a href="/privacidad" class="font-medium text-zinc-300 underline decoration-zinc-600 underline-offset-2 hover:text-forge-400">Aviso de privacidad</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quoteForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const selectedRadio = form.querySelector<HTMLInputElement>('input[name="projectType"]:checked');
    const dimensions = form.querySelector<HTMLInputElement>('#dimensions')?.value.trim() || 'A definir';
    const location = form.querySelector<HTMLInputElement>('#locationInput')?.value.trim() || 'A coordinar';
    const details = form.querySelector<HTMLTextAreaElement>('#details')?.value.trim() || 'Sin detalles adicionales';
    const whatsappNumber = form.dataset.whatsappNumber;

    if (!whatsappNumber) return;

    const message = [
      'Hola Tony! Te escribo desde la web para consultar por un trabajo:',
      '',
      '🛠 *TRABAJO:* ' + (selectedRadio?.value || 'Trabajo a medida'),
      '📐 *MEDIDAS:* ' + dimensions,
      '📍 *ZONA:* ' + location,
      '📝 *DETALLES:* ' + details,
      '',
      'Quedo atento para coordinar y ampliar la información.',
    ].join('\\n');

    window.open('https://wa.me/' + whatsappNumber + '?text=' + encodeURIComponent(message), '_blank', 'noopener,noreferrer');
  });
</script>
