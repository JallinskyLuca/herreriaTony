---
interface Props {
  variant?: 'horizontal' | 'compact' | 'stamp' | 'icon';
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { variant = 'horizontal', class: className = '', size = 'md' } = Astro.props;

const imageSizes = {
  sm: 'w-10 h-10',
  md: 'w-12 h-12 md:w-14 md:h-14',
  lg: 'w-20 h-20 md:w-24 md:h-24',
  xl: 'w-36 h-36 md:w-44 md:h-44',
};
---

{variant === 'icon' && (
  <div class={`relative inline-flex items-center justify-center shrink-0 ${imageSizes[size]} ${className}`}>
    <img
      src="/images/logo.webp"
      alt="Herrería Tony Logo"
      class="w-full h-full object-contain rounded-full shadow-[0_0_15px_rgba(234,88,12,0.35)]"
      loading="eager"
    />
  </div>
)}

{variant === 'horizontal' && (
  <div class={`inline-flex items-center gap-3 select-none ${className}`}>
    <!-- Official Logo Image -->
    <div class="relative shrink-0">
      <div class="w-12 h-12 md:w-14 md:h-14 rounded-full overflow-hidden border border-zinc-700/80 shadow-[0_0_12px_rgba(234,88,12,0.4)] bg-zinc-950">
        <img
          src="/images/logo.webp"
          alt="Herrería Tony Logo"
          class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-300"
          loading="eager"
        />
      </div>
      <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-forge-500 shadow-[0_0_8px_#EA580C] animate-pulse"></span>
    </div>

    <!-- Typography -->
    <div class="flex flex-col">
      <div class="flex items-baseline gap-1.5 leading-none">
        <span class="font-display tracking-wider text-2xl md:text-3xl text-zinc-100 uppercase font-bold drop-shadow-sm">
          HERRERÍA <span class="text-forge-500">TONY</span>
        </span>
      </div>
      <div class="flex items-center gap-1.5 text-[10px] md:text-[11px] font-mono tracking-[0.2em] uppercase text-zinc-400 mt-1">
        <span class="text-forge-500 font-bold">DESDE 1980</span>
        <span class="w-1 h-1 rounded-full bg-zinc-600"></span>
        <span class="text-zinc-300">HERRERÍA & ALBAÑILERÍA</span>
      </div>
    </div>
  </div>
)}

{variant === 'stamp' && (
  <div class={`relative inline-flex flex-col items-center justify-center ${className}`}>
    <div class="relative p-2 rounded-full border-2 border-forge-500/40 bg-zinc-950/90 shadow-[0_0_30px_rgba(234,88,12,0.25)]">
      <img
        src="/images/logo.webp"
        alt="Sello Herrería Tony"
        class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover shadow-inner"
        loading="lazy"
      />
      <div class="absolute inset-0 rounded-full border border-zinc-700/60 pointer-events-none"></div>
    </div>
  </div>
)}
