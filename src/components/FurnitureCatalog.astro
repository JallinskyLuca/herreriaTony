---
import { MessageCircle } from 'lucide-astro';
import { buildWhatsAppUrl } from '../config/site';

const furniture = [
  {
    code: 'M-01',
    name: 'Banco industrial de hierro y madera',
    image: '/images/catalogo/banco-industrial-hierro-madera.webp',
    imageWidth: 1229,
    imageHeight: 1280,
    description: 'Banco de líneas rectas con estructura metálica de marco cerrado y asiento de tablas de madera. Una pieza firme y versátil para comedor, galería, recibidor o local comercial.',
    details: ['Estructura de perfil metálico', 'Asiento de madera', 'Medidas y terminación a elección'],
  },
  {
    code: 'M-02',
    name: 'Estantería modular asimétrica',
    image: '/images/catalogo/estanteria-modular-asimetrica.webp',
    imageWidth: 992,
    imageHeight: 1585,
    description: 'Diseño vertical con módulos desplazados que combina espacios abiertos de distintas alturas. Funciona como biblioteca, exhibidor o separador visual.',
    details: ['Módulos de diferentes tamaños', 'Estantes de madera', 'Estructura metálica de piso'],
  },
  {
    code: 'M-03',
    name: 'Biblioteca industrial abierta',
    image: '/images/catalogo/biblioteca-industrial-cinco-estantes.webp',
    imageWidth: 1024,
    imageHeight: 1536,
    description: 'Biblioteca amplia de cinco niveles con estantes pasantes y estructura metálica abierta. Pensada para libros, objetos decorativos, plantas o exhibición comercial.',
    details: ['Cinco niveles de guardado', 'Estantes amplios y abiertos', 'Fabricación a medida'],
  },
  {
    code: 'M-04',
    name: 'Estantería torre con refuerzo cruzado',
    image: '/images/catalogo/estanteria-torre-industrial.webp',
    imageWidth: 1024,
    imageHeight: 1536,
    description: 'Estantería angosta y alta con cuatro niveles de madera y cruces metálicas posteriores. Aprovecha espacios reducidos sin perder presencia ni estabilidad.',
    details: ['Formato vertical compacto', 'Refuerzos posteriores en cruz', 'Apoyos regulables'],
  },
];
---

<section id="catalogo" aria-labelledby="catalogo-titulo" class="scroll-mt-24 border-b border-zinc-800 bg-iron-900 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 grid gap-5 border-b border-zinc-800 pb-8 lg:grid-cols-[1fr_24rem] lg:items-end">
      <div>
        <p class="mb-3 flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.18em] text-forge-400">
          <span class="size-2 rounded-full bg-forge-500"></span>
          Muebles fabricados en el taller
        </p>
        <h2 id="catalogo-titulo" class="max-w-4xl font-display text-4xl font-bold uppercase leading-none tracking-tight text-zinc-100 sm:text-5xl lg:text-6xl">
          Catálogo de <span class="text-forge-500">hierro y madera</span>
        </h2>
      </div>
      <p class="text-sm leading-relaxed text-zinc-400 lg:text-base">
        Cada modelo se fabrica a pedido. Consultanos por WhatsApp para definir medidas, terminación y detalles según el espacio donde lo vas a usar.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 xl:gap-8">
      {furniture.map((item) => (
        <article class="group grid overflow-hidden rounded-2xl border border-zinc-800 bg-iron-850 transition-colors hover:border-forge-500/60 sm:grid-cols-[42%_58%]">
          <div class="relative min-h-[19rem] overflow-hidden bg-[#d0d0d2] sm:min-h-[27rem]">
            <img
              src={item.image}
              width={item.imageWidth}
              height={item.imageHeight}
              alt={item.name}
              class="absolute inset-0 size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute left-3 top-3 rounded-md border border-zinc-600/80 bg-zinc-950/85 px-2.5 py-1 font-mono text-[10px] font-bold tracking-widest text-forge-400 backdrop-blur-sm">
              MODELO {item.code}
            </span>
          </div>

          <div class="flex flex-col p-5 sm:p-6">
            <h3 class="font-display text-2xl font-bold uppercase leading-tight tracking-wide text-zinc-100 transition-colors group-hover:text-forge-400 lg:text-3xl">
              {item.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-300">{item.description}</p>

            <ul class="mt-5 space-y-2 border-t border-zinc-800 pt-4 font-mono text-[11px] text-zinc-300">
              {item.details.map((detail) => (
                <li class="flex items-start gap-2">
                  <span class="shrink-0 font-bold text-forge-500">▸</span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>

            <a
              href={buildWhatsAppUrl(`Hola Tony! Vi el ${item.name} (modelo ${item.code}) en el catálogo y quiero consultar por medidas, terminación y disponibilidad.`)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-forge-500/70 bg-forge-500/10 px-4 py-3 font-mono text-xs font-bold uppercase tracking-wider text-forge-400 transition-colors hover:bg-forge-500 hover:text-zinc-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-forge-400 sm:mt-auto"
            >
              <MessageCircle aria-hidden="true" class="size-4" stroke-width={2.25} />
              Consultar este modelo
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
