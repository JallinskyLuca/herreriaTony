---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Página no encontrada | Herrería Tony" description="La página solicitada no está disponible." noindex>
  <Navbar />
  <main class="flex min-h-[60vh] items-center bg-iron-950">
    <section class="mx-auto w-full max-w-4xl px-4 py-20 text-center sm:px-6">
      <p class="font-mono text-sm font-bold text-forge-400">ERROR 404</p>
      <h1 class="mt-4 font-display text-5xl font-bold uppercase leading-none text-zinc-100 sm:text-7xl">Esta página no está disponible</h1>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-zinc-400">
        Es posible que el enlace haya cambiado o que la dirección esté incompleta.
      </p>
      <a href="/" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-forge-500 px-6 py-3 font-semibold text-zinc-950 transition-colors hover:bg-forge-400">
        Volver al inicio
      </a>
    </section>
  </main>
  <Footer />
</Layout>
